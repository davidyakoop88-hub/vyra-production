{
  "name": "vyra-desktop",
  "version": "1.2.4",
  "description": "VYRA — TikTok LIVE overlay studio, desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test test/*.test.js",
    "build:store": "node bygg-store.js"
  },
  "dependencies": {
    "tiktok-live-connector": "^2.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vyra.desktop",
    "productName": "VYRA",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist2"
    },
    "files": [
      "main.js",
      "local-server.js",
      "tiktok-service.js",
      "tiktok-fields.js",
      "obs-service.js",
      "updater.js",
      "update-config.json",
      "splash.html",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "artifactName": "VYRA-Setup.exe",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VYRA",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "**/*",
          "!electron-app",
          "!electron-app/**",
          "!.git",
          "!.git/**",
          "!.tools",
          "!.tools/**",
          "!.claude",
          "!.claude/**",
          "!node_modules",
          "!node_modules/**",
          "!tiktok-bridge/node_modules",
          "!tiktok-bridge/node_modules/**",
          "!VYRA-Setup.exe",
          "!VYRA-Download.zip",
          "!vyra-payload.zip",
          "!vyra-state-backup.json",
          "!outputs",
          "!outputs/**",
          "!tools",
          "!tools/**",
          "!*.ps1",
          "!.download-staging",
          "!.download-staging/**",
          "!CLAUDE-HANDOFF.md",
          "!CLAUDE.md",
          "!.gitignore",
          "!server",
          "!server/**",
          "!.github",
          "!.github/**",
          "!scripts",
          "!scripts/**",
          "!docs",
          "!docs/**",
          "!docker-compose.yml",
          "!Caddyfile",
          "!.dockerignore",
          "!package.json",
          "!package-lock.json",
          "!node_modules",
          "!node_modules/**",
          "!tests",
          "!tests/**"
        ]
      }
    ],
    "appx": {
      "applicationId": "VYRA",
      "displayName": "VYRA",
      "backgroundColor": "#100717",
      "languages": [
        "sv-SE",
        "en-US"
      ],
      "electronUpdaterAware": false,
      "showNameOnTiles": true,
      "artifactName": "VYRA-Store-${version}.appx"
    }
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "glob": "^13.0.6",
    "js-yaml": "^4.3.1"
  }
}
