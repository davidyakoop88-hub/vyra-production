# VYRA staging — a REAL deployment, hardened exactly like production.
#
# APP_ENV is a separate axis from NODE_ENV. Staging runs NODE_ENV=production too: that is what turns
# on every hardening path in the stack, and staging must not become a development box just because
# it needs test payment keys. APP_ENV only says which real deployment this is.
#
# Nothing here is relaxed relative to production. Every secret, URL and token check applies
# identically, and in one respect staging is STRICTER: OBJECT_KEY_PREFIX is required.
#
# Nothing in this file may be copied from production. Generate fresh secrets — a staging box that
# holds production credentials is production, whatever it is called.
APP_ENV=staging
NODE_ENV=production
PORT=8080

# Staging's own hostname, not vyralive.app.
APP_ORIGIN=https://vyra-api-staging.up.railway.app

# The STAGING Postgres and Redis. Never the production instances — staging runs migrations and
# writes test data, and pointing it at production means a schema change lands there first.
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_POSTGRES_HOST:5432/railway
DATABASE_SSL=require
DB_POOL_SIZE=10
REDIS_URL=rediss://STAGING_REDIS_HOST:6380
REDIS_REQUIRED=true

# Fresh values, unique to staging AND unique from each other (the validator enforces the latter).
APP_ENCRYPTION_KEY=GENERATE_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
TIKTOK_INGEST_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
METRICS_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
MEDIA_SCAN_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET

# Object storage. Either give staging its own bucket, or share the bucket and set a prefix —
# one of the two is REQUIRED under APP_ENV=staging, so staging uploads can never be written into
# production's key namespace. The prefix is the cheaper option and needs no new bucket.
OBJECT_BUCKET=vyra-media
OBJECT_KEY_PREFIX=staging/
OBJECT_REGION=eu-north-1
OBJECT_ENDPOINT=https://OBJECT_STORAGE_ENDPOINT
OBJECT_ACCESS_KEY=STAGING_OBJECT_ACCESS_KEY
OBJECT_SECRET_KEY=STAGING_OBJECT_SECRET_KEY
# Leave CDN_ORIGIN unset on staging unless a staging CDN exists — pointing it at the production
# CDN would serve staging uploads from the production domain.
MEDIA_MAX_MB=100
MEDIA_SCAN_REQUIRED=true

# Stripe TEST mode. A sk_live_ key here is refused outright, not warned about: staging must never be
# able to charge a real card. The webhook secret and price must come from the SAME test-mode Stripe
# account — a live-mode price id will not resolve under a test key, and a live webhook secret will
# fail signature verification.
#   Test cards: 4242 4242 4242 4242 succeeds, 4000 0000 0000 0002 is declined.
#   Webhook secret: Stripe CLI (`stripe listen`) or a test-mode endpoint in the dashboard.
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_TEST_MODE_ENDPOINT_SECRET
STRIPE_PRICE_MONTHLY=price_REPLACE_TEST_MODE_PRICE

# Email. Staging sends real mail through Resend if you let it, so the safe combination is a
# SEPARATE Resend API key restricted to a domain or subdomain you control (e.g. staging.vyralive.app)
# and never the production key. The validator requires a verified, non-example domain in both
# environments; it cannot tell a staging key from a production one, so this one is on you.
# Until a staging domain is verified, Resend's own onboarding sender works: onboarding@resend.dev
RESEND_API_KEY=re_REPLACE_STAGING_ONLY_KEY
EMAIL_FROM=VYRA Staging <noreply@staging.vyralive.app>
# Route alerts somewhere that is not the production on-call channel.
ALERT_EMAIL_TO=staging-alerts@vyralive.app
ALERT_WEBHOOK_URL=

# Desktop metadata. These are only served to clients as download metadata and are validated for
# shape, not reachability — so staging may point at the same installer as production. Do NOT invent
# a fake SHA256: the value is what a client verifies the download against, and a wrong one makes
# staging report a corrupt installer. Copy the real values, or point at a staging build.
DESKTOP_DOWNLOAD_URL=https://download.vyralive.app/VYRA-Setup.exe
DESKTOP_VERSION=1.0.0
DESKTOP_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
DESKTOP_SIZE_BYTES=REPLACE_WITH_INSTALLER_BYTES

SESSION_DAYS=14
EVENT_RETENTION=10000
MEMORY_WARN_MB=400
EVENT_LOOP_WARN_MS=250
CAPACITY_WARN_DB_WAITING=5
CAPACITY_WARN_NOTIFICATION_QUEUE=1000

# Fleet capacity. Same value in BOTH services or the limit means two different things: the API
# refuses past its number, the manager runs up to its own.
MAX_BRIDGES=5

# tiktok-connection-manager (tiktok-bridge/connection-manager.js) — reads DATABASE_URL above.
# VYRA_CLOUD_URL must point at the STAGING API, or staging bridges post their events into production.
VYRA_CLOUD_URL=https://vyra-api-staging.up.railway.app
VYRA_INGEST_TOKEN=SAME_VALUE_AS_TIKTOK_INGEST_TOKEN_ABOVE
# Leave VYRA_SERVER_URL unset — it addresses the desktop build's local server on 127.0.0.1:4173,
# which does not exist in the cloud.
DISCORD_ALERT_WEBHOOK_URL=
PROXY_LIST=
