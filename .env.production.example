NODE_ENV=production
PORT=8080
APP_ORIGIN=https://vyralive.app
DATABASE_URL=postgresql://USER:PASSWORD@MANAGED_POSTGRES_HOST:5432/vyra
DATABASE_SSL=require
DB_POOL_SIZE=20
REDIS_URL=rediss://MANAGED_REDIS_HOST:6380
REDIS_REQUIRED=true
APP_ENCRYPTION_KEY=GENERATE_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
TIKTOK_INGEST_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
METRICS_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
MEDIA_SCAN_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
OBJECT_BUCKET=vyra-media
OBJECT_REGION=eu-north-1
OBJECT_ENDPOINT=https://OBJECT_STORAGE_ENDPOINT
OBJECT_ACCESS_KEY=OBJECT_STORAGE_ACCESS_KEY
OBJECT_SECRET_KEY=OBJECT_STORAGE_SECRET_KEY
CDN_ORIGIN=https://cdn.vyralive.app
MEDIA_MAX_MB=100
MEDIA_SCAN_REQUIRED=true
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRICE_MONTHLY=price_REPLACE
RESEND_API_KEY=re_REPLACE
EMAIL_FROM=VYRA <billing@vyralive.app>
ALERT_WEBHOOK_URL=https://alerts.vyralive.app/vyra
DESKTOP_DOWNLOAD_URL=https://download.vyralive.app/VYRA-Setup.exe
DESKTOP_VERSION=1.0.0
DESKTOP_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
DESKTOP_SIZE_BYTES=REPLACE_WITH_INSTALLER_BYTES
SESSION_DAYS=14
EVENT_RETENTION=10000
MEMORY_WARN_MB=400
EVENT_LOOP_WARN_MS=250
CAPACITY_WARN_DB_WAITING=5
CAPACITY_WARN_NOTIFICATION_QUEUE=1000
