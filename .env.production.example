# APP_ENV is a separate axis from NODE_ENV. Both staging and production run NODE_ENV=production —
# that is what enables every hardening path — and APP_ENV says WHICH real deployment this is.
# Required, never defaulted: a missing value fails the boot rather than guessing, because guessing
# production would block a staging deploy and guessing staging would let production take payments
# in test mode. See .env.staging.example for the staging counterpart.
APP_ENV=production

NODE_ENV=production
PORT=8080
APP_ORIGIN=https://vyralive.app
DATABASE_URL=postgresql://USER:PASSWORD@MANAGED_POSTGRES_HOST:5432/vyra
DATABASE_SSL=require
DB_POOL_SIZE=20
REDIS_URL=rediss://MANAGED_REDIS_HOST:6380
REDIS_REQUIRED=true
APP_ENCRYPTION_KEY=GENERATE_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
TIKTOK_INGEST_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
METRICS_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
MEDIA_SCAN_TOKEN=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
OBJECT_BUCKET=vyra-media
# Optional in production (leave empty — keys stay byte-for-byte what they are today).
# REQUIRED in staging, so staging objects can never land in production's namespace.
OBJECT_KEY_PREFIX=
OBJECT_REGION=eu-north-1
OBJECT_ENDPOINT=https://OBJECT_STORAGE_ENDPOINT
OBJECT_ACCESS_KEY=OBJECT_STORAGE_ACCESS_KEY
OBJECT_SECRET_KEY=OBJECT_STORAGE_SECRET_KEY
CDN_ORIGIN=https://cdn.vyralive.app
MEDIA_MAX_MB=100
MEDIA_SCAN_REQUIRED=true
# Must be sk_live_ when APP_ENV=production. A sk_test_ key is refused outright, not warned about.
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRICE_MONTHLY=price_REPLACE
RESEND_API_KEY=re_REPLACE
EMAIL_FROM=VYRA <billing@vyralive.app>
ALERT_WEBHOOK_URL=https://alerts.vyralive.app/vyra
DESKTOP_DOWNLOAD_URL=https://download.vyralive.app/VYRA-Setup.exe
DESKTOP_VERSION=1.0.0
DESKTOP_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
DESKTOP_SIZE_BYTES=REPLACE_WITH_INSTALLER_BYTES
SESSION_DAYS=14
EVENT_RETENTION=10000
MEMORY_WARN_MB=400
EVENT_LOOP_WARN_MS=250
CAPACITY_WARN_DB_WAITING=5
CAPACITY_WARN_NOTIFICATION_QUEUE=1000

# tiktok-connection-manager fleet (tiktok-bridge/connection-manager.js) — reads DATABASE_URL above
VYRA_CLOUD_URL=https://vyralive.app
VYRA_INGEST_TOKEN=SAME_VALUE_AS_TIKTOK_INGEST_TOKEN_ABOVE
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE
PROXY_LIST=
