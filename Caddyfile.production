{$VYRA_DOMAIN} {
  encode zstd gzip
  @api path /api/* /health/*
  reverse_proxy @api {$VYRA_API_UPSTREAM} {
    lb_policy least_conn
    health_uri /health/ready
    health_interval 10s
  }
  # Samma cachningsregler som ./Caddyfile, som ar den Dockerfile:55 faktiskt kopierar och alltsa
  # den som kor. Den har filen anvands av web/Dockerfile, som inte ar bygget Railway korr - men den
  # SAKNADE HTML-regeln helt, sa ett byte hit hade borjat cacha sjalva appskalet heuristiskt. Ett
  # test jamfor de tva filernas cachningsregler mot varandra sa de inte kan glida isar igen.
  @html path / *.html
  header @html Cache-Control "no-cache, no-store, must-revalidate"
  @assets path *.js *.css
  header @assets Cache-Control "no-cache"

  root * /srv
  try_files {path} /index.html
  file_server
  request_body {
    max_size 6MB
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    -Server
  }
  log {
    output stdout
    format json
  }
}
