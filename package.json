{
  "name": "vyra-client",
  "private": true,
  "description": "Testkörning för klientfilerna i repotroten. Ingen runtime-dependency: webbläsaren laddar filerna direkt, och ingenting här packas med i Railway-imagen eller desktopinstallern.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:contract": "node --test tests/event-contract.test.js",
    "test:fuzz": "node --test tests/live-fuzz.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:ci": "npm run test:contract && npm run test:fuzz && npm test && npm run test:browser",
    "test:browser": "node --test tests/browser/*.browser.test.js",
    "karta": "node scripts/generate-catalog-map.js",
    "domaner": "node scripts/domaner.js",
    "test:doman": "node scripts/domaner.js test",
    "test:visual": "node --test tests/visual/visuell-regression.browser.test.js",
    "test:visual:update": "node scripts/visuell-referens.js"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "playwright-core": "^1.62.1"
  }
}
