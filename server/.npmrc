# Inga installationsskript från beroenden (2026-10-21). msedge-tts 2.1.0 — versionen som når Microsofts
# nya TTS-adress — har preinstall "npx only-allow pnpm", som avbryter `npm ci` när npm kör den. Inget
# annat serverberoende har ett installationsskript (package-lock: hasInstallScript), så ingenting går förlorat.
ignore-scripts=true
