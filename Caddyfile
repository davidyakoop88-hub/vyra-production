:80 {
  encode zstd gzip

  @html path / *.html
  header @html Cache-Control "no-cache, no-store, must-revalidate"

  # Skript och stilmallar revalideras i stallet for att gissas.
  #
  # Utan Cache-Control faller webblasaren tillbaka pa HEURISTISK cachning: den behaller svaret i
  # ungefar 10 % av tiden sedan Last-Modified. Last-Modified ar deploytidpunkten for alla filer,
  # sa en andring kunde vara osynlig i upp till en tiondel av tiden sedan forra deployen - olika
  # lange for olika anvandare. Skyddet var ?v=-markorer i media.js, satta pa ungefar tio av
  # femtio filer; gift-fireworks.css var en av de fyrtio utan och laddades osynligt gammal.
  #
  # `no-cache` betyder inte "cacha inte" utan "cacha, men fraga alltid forst". file_server skickar
  # redan ETag, sa fragan blir ett tomt 304-svar. Bilder, ljud och typsnitt lamnas med flit utanfor:
  # de ar i praktiken bara tillagda, aldrig andrade, och tjanar pa att cachas.
  @assets path *.js *.css
  header @assets Cache-Control "no-cache"

  @backend path /api/* /health/*
  handle @backend {
    reverse_proxy api:8080 {
      lb_policy least_conn
      health_uri /health/ready
      health_interval 10s
    }
  }

  handle {
    root * /app
    try_files {path} /index.html
    file_server
  }

  header {
    # Steg 1 av tre. HSTS och CSP fanns en gang i Caddyfile.production, men den filen deployades
    # aldrig (Dockerfile:55 kopierar den har) och ar borttagen. Uppmatt pa vyralive.app innan det
    # har: HSTS och CSP saknades HELT, och ingenting sa till om det.
    #
    # Trappan ar 300 -> 86400 -> ett ar med includeSubDomains, ett steg i taget med verifiering
    # emellan. Steg 1 (300 s) verifierades i produktion 2026-08-06. Vi star nu pa STEG 2.
    #
    # `preload` star med FLIT inte har: den bakas in i webblasarna sjalva och tar manader att ta
    # sig ur. Den gamla konfigurationen hade den, och det var ingen som beslutade det.
    #
    # `includeSubDomains` vantar till steg 3, och kraver att ALLA underdomaner racknats upp forst.
    # Bara downloads.vyralive.app ar kand och verifierad att svara over HTTPS.
    Strict-Transport-Security "max-age=86400"
    # Bara de fyra direktiv som inte KAN slacka appen, for de blockerar sadant appen aldrig gor:
    # enda formularet i repot (operations.html) saknar action, enda iframen ar en relativ sokvag
    # till egen origin, ingen <base> sats nagonstans, och det finns inga <object>/<embed>.
    #
    # Resursdirektiven - script, style, img, media, connect - ar MEDVETET utelamnade. De kan blanka
    # Studion och slacka avatarer i OBS. Innan de ens far kora i Report-Only behovs en
    # insamlingsendpoint och en riktig OBS-session: OBS kor CEF, och uteblivna rapporter darifran
    # bevisar ingenting. Ett test faller den som lagger till dem i forbifarten.
    Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
}
